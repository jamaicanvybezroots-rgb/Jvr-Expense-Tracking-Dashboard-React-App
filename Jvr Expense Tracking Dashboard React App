export default function JVRExpenseTracker() {
  const categories = [
    'Raw Materials',
    'Packaging',
    'Alcohol',
    'Labor',
    'Utilities',
    'Transportation',
    'Equipment',
    'Marketing',
    'Startup Expenses',
    'Licensing & Permits',
    'Construction & Renovation',
    'Professional Services',
    'Investor Contributions',
    'Miscellaneous'
  ];

  const sampleExpenses = [
    {
      date: '2026-05-01',
      category: 'Startup Expenses',
      item: 'Company Registration',
      amount: 85000,
      notes: 'Initial setup filing'
    },
    {
      date: '2026-05-01',
      category: 'Investor Contributions',
      item: 'Angel Investor Round 1',
      amount: 2500000,
      notes: 'Seed funding contribution'
    },
    {
      date: '2026-05-02',
      category: 'Raw Materials',
      item: 'Condensed Milk',
      amount: 450000,
      notes: 'Initial production batch'
    },
    {
      date: '2026-05-02',
      category: 'Packaging',
      item: '200ml Bottles',
      amount: 120000,
      notes: 'Bottle inventory'
    },
    {
      date: '2026-05-03',
      category: 'Alcohol',
      item: 'Rum Supply',
      amount: 350000,
      notes: 'Batch blending'
    }
  ];

  const [expenses, setExpenses] = React.useState(sampleExpenses);
  const [form, setForm] = React.useState({
    date: '',
    category: 'Raw Materials',
    item: '',
    amount: '',
    notes: ''
  });

  const addExpense = () => {
    if (!form.date || !form.item || !form.amount) return;

    setExpenses([
      {
        ...form,
        amount: Number(form.amount)
      },
      ...expenses
    ]);

    setForm({
      date: '',
      category: 'Raw Materials',
      item: '',
      amount: '',
      notes: ''
    });
  };

  const totalExpenses = expenses
    .filter((item) => item.category !== 'Investor Contributions')
    .reduce((sum, item) => sum + item.amount, 0);

  const totalInvestorFunding = expenses
    .filter((item) => item.category === 'Investor Contributions')
    .reduce((sum, item) => sum + item.amount, 0);

  const operationalBalance = totalInvestorFunding - totalExpenses;

  const categoryTotals = categories.map((category) => {
    const total = expenses
      .filter((e) => e.category === category)
      .reduce((sum, e) => sum + e.amount, 0);

    return {
      category,
      total
    };
  });

  const exportCSV = () => {
    const headers = ['Date', 'Category', 'Item', 'Amount', 'Notes'];

    const rows = expenses.map((e) => [
      e.date,
      e.category,
      e.item,
      e.amount,
      e.notes
    ]);

    const csvContent = [headers, ...rows]
      .map((row) => row.join(','))
      .join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', 'jvr_expenses.csv');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <div className="min-h-screen bg-gray-100 p-6">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="bg-white rounded-3xl shadow-lg p-6">
          <h1 className="text-4xl font-bold mb-2">JVR Expense Tracking Dashboard</h1>
          <p className="text-gray-500">
            Production costing, procurement tracking, and operational reporting.
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div className="bg-white rounded-3xl shadow p-6">
            <h2 className="text-lg font-semibold mb-2">Total Expenses</h2>
            <p className="text-3xl font-bold">
              JMD ${totalExpenses.toLocaleString()}
            </p>
          </div>

          <div className="bg-white rounded-3xl shadow p-6">
            <h2 className="text-lg font-semibold mb-2">Expense Entries</h2>
            <p className="text-3xl font-bold">{expenses.length}</p>
          </div>

          <div className="bg-white rounded-3xl shadow p-6">
            <h2 className="text-lg font-semibold mb-2">Largest Category</h2>
            <p className="text-xl font-bold">
              {
                categoryTotals.sort((a, b) => b.total - a.total)[0]
                  ?.category
              }
            </p>
          </div>

          <div className="bg-white rounded-3xl shadow p-6">
            <h2 className="text-lg font-semibold mb-2">Investor Funding</h2>
            <p className="text-3xl font-bold">
              JMD ${totalInvestorFunding.toLocaleString()}
            </p>
            <p className="text-sm text-gray-500 mt-2">
              Remaining Operational Balance:
            </p>
            <p className="text-lg font-semibold">
              JMD ${operationalBalance.toLocaleString()}
            </p>
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div className="bg-white rounded-3xl shadow p-6 space-y-4">
            <h2 className="text-2xl font-semibold">Add Expense</h2>

            <input
              type="date"
              value={form.date}
              onChange={(e) => setForm({ ...form, date: e.target.value })}
              className="w-full border rounded-xl p-3"
            />

            <select
              value={form.category}
              onChange={(e) =>
                setForm({ ...form, category: e.target.value })
              }
              className="w-full border rounded-xl p-3"
            >
              {categories.map((category) => (
                <option key={category}>{category}</option>
              ))}
            </select>

            <input
              type="text"
              placeholder="Expense Item"
              value={form.item}
              onChange={(e) => setForm({ ...form, item: e.target.value })}
              className="w-full border rounded-xl p-3"
            />

            <input
              type="number"
              placeholder="Amount (JMD)"
              value={form.amount}
              onChange={(e) => setForm({ ...form, amount: e.target.value })}
              className="w-full border rounded-xl p-3"
            />

            <textarea
              placeholder="Notes"
              value={form.notes}
              onChange={(e) => setForm({ ...form, notes: e.target.value })}
              className="w-full border rounded-xl p-3"
            />

            <button
              onClick={addExpense}
              className="w-full bg-black text-white rounded-2xl py-3 text-lg font-semibold"
            >
              Add Expense
            </button>
          </div>

          <div className="bg-white rounded-3xl shadow p-6">
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-2xl font-semibold">Category Report</h2>

              <button
                onClick={exportCSV}
                className="bg-gray-900 text-white px-4 py-2 rounded-xl"
              >
                Export CSV
              </button>
            </div>

            <div className="space-y-3">
              {categoryTotals.map((item) => (
                <div
                  key={item.category}
                  className="border rounded-2xl p-4 flex items-center justify-between"
                >
                  <span className="font-medium">{item.category}</span>
                  <span className="font-bold">
                    JMD ${item.total.toLocaleString()}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div className="bg-white rounded-3xl shadow p-6">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-2xl font-semibold">Expense Log</h2>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full border-collapse">
              <thead>
                <tr className="border-b">
                  <th className="text-left p-3">Date</th>
                  <th className="text-left p-3">Category</th>
                  <th className="text-left p-3">Item</th>
                  <th className="text-left p-3">Amount</th>
                  <th className="text-left p-3">Notes</th>
                </tr>
              </thead>

              <tbody>
                {expenses.map((expense, index) => (
                  <tr key={index} className="border-b hover:bg-gray-50">
                    <td className="p-3">{expense.date}</td>
                    <td className="p-3">{expense.category}</td>
                    <td className="p-3">{expense.item}</td>
                    <td className="p-3 font-semibold">
                      JMD ${expense.amount.toLocaleString()}
                    </td>
                    <td className="p-3 text-gray-500">{expense.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div className="bg-white rounded-3xl shadow p-6">
          <h2 className="text-2xl font-semibold mb-4">Future Expansion Ideas</h2>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-700">
            <ul className="space-y-2 list-disc pl-6">
              <li>Inventory management</li>
              <li>Supplier database</li>
              <li>Batch production costing</li>
              <li>Alcohol usage tracking</li>
              <li>Herbal extraction tracking</li>
            </ul>

            <ul className="space-y-2 list-disc pl-6">
              <li>Profit margin calculations</li>
              <li>Bottle production reports</li>
              <li>Export documentation logs</li>
              <li>Payroll integration</li>
              <li>Multi-location support</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  );
}
